<Window x:Class="SpotifyPopup.AboutWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:loc="clr-namespace:SpotifyPopup"
 Title="{loc:Text AboutTitle}" Width="460" Height="490" MinWidth="400" MinHeight="430" WindowStartupLocation="CenterOwner"
 Background="#172522" Foreground="#EAF6F3" ShowInTaskbar="False" ResizeMode="CanResize" Icon="/SpotifyPopup;component/Assets/logo.ico">
 <Grid Margin="28">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Orientation="Horizontal" Margin="0,0,0,24">
   <Image x:Name="AppLogo" Source="/SpotifyPopup;component/Assets/logo.ico" Width="64" Height="64" Margin="0,0,18,0" AutomationProperties.Name="Spotify Popup logo"/>
   <StackPanel VerticalAlignment="Center">
    <TextBlock Text="Spotify Popup" FontSize="24" FontWeight="SemiBold" Foreground="#EAF6F3"/>
    <TextBlock x:Name="VersionText" FontSize="12" Foreground="#B7CEC2" Margin="0,5,0,0"/>
   </StackPanel>
  </StackPanel>
  <StackPanel Grid.Row="1" Margin="0,0,0,20">
   <TextBlock Text="{loc:Text CreatedBy}" Foreground="#B7CEC2" FontSize="12"/>
   <TextBlock x:Name="AuthorText" Text="Simone Campisi" Foreground="#EAF6F3" FontSize="16" Margin="0,4,0,18"/>
   <TextBlock Text="{loc:Text License}" Foreground="#B7CEC2" FontSize="12"/>
   <TextBlock Text="{loc:Text LicenseName}" Foreground="#EAF6F3" FontSize="14" TextWrapping="Wrap" Margin="0,4,0,0"/>
  </StackPanel>
  <TextBox x:Name="LicenseText" Grid.Row="2" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
   Background="#10201B" Foreground="#C9DED3" BorderBrush="#41594F" Padding="10" FontSize="11" AutomationProperties.Name="{loc:Text LicenseText}"/>
  <Button x:Name="CloseButton" Grid.Row="3" Content="{loc:Text Close}" Padding="20,7" HorizontalAlignment="Right" Margin="0,20,0,0" IsCancel="True" IsDefault="True" Click="CloseClick"/>
 </Grid>
</Window>
