<Window x:Class="SpotifyPopup.AboutWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:loc="clr-namespace:SpotifyPopup" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
 Title="{loc:Text AboutTitle}" Width="500" Height="610" MinWidth="460" MinHeight="520" WindowStartupLocation="CenterOwner" WindowStyle="None" AllowsTransparency="True" Background="Transparent" Foreground="#F3F5F7" FontFamily="Segoe UI Variable Text, Segoe UI" ShowInTaskbar="False" ResizeMode="CanResize" Icon="/SpotifyPopup;component/Assets/logo.ico" UseLayoutRounding="True">
 <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="56" ResizeBorderThickness="6" GlassFrameThickness="0"/></shell:WindowChrome.WindowChrome>
 <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="Theme.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
 <Border Background="{StaticResource CanvasBrush}" CornerRadius="20" BorderBrush="#454C55" BorderThickness="1" Margin="1"><Grid>
  <Grid.RowDefinitions><RowDefinition Height="56"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <Grid Margin="24,0,14,0"><TextBlock Text="{loc:Text About}" FontSize="13" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
   <Button x:Name="CloseButton" Content="&#xE8BB;" Style="{StaticResource GlassButton}" HorizontalAlignment="Right" VerticalAlignment="Center" IsCancel="True" Click="CloseClick" ToolTip="{loc:Text Close}" AutomationProperties.Name="{loc:Text Close}" shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
  </Grid>
  <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="28,4,28,24"><StackPanel>
   <StackPanel HorizontalAlignment="Center" Margin="0,0,0,28">
    <Image x:Name="AppLogo" Width="72" Height="72" RenderOptions.BitmapScalingMode="HighQuality" AutomationProperties.Name="{loc:Text LogoName}"/>
    <TextBlock Text="Spotify Popup" FontSize="28" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,14,0,6"/>
    <TextBlock Text="{loc:Text AboutTagline}" Style="{StaticResource Hint}" HorizontalAlignment="Center"/>
    <Border CornerRadius="10" Background="#263B33" Padding="10,4" HorizontalAlignment="Center" Margin="0,12,0,0"><TextBlock x:Name="VersionText" FontSize="11" Foreground="{StaticResource AccentBrush}"/></Border>
   </StackPanel>
   <Border Style="{StaticResource Card}"><StackPanel>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{loc:Text CreatedBy}" Style="{StaticResource Hint}"/><TextBlock x:Name="AuthorText" Grid.Column="1" Text="Simone Campisi" FontSize="13" FontWeight="SemiBold"/></Grid>
    <Border Height="1" Background="#343A42" Margin="0,16"/>
    <TextBlock Text="{loc:Text LicenseName}" FontSize="13"/>
    <Button x:Name="LicenseButton" Content="{loc:Text ReadLicense}" Style="{StaticResource QuietButton}" Click="LicenseClick" HorizontalAlignment="Left" Padding="0,8" Foreground="{StaticResource AccentBrush}" Margin="0,4,0,0"/>
    <TextBox x:Name="LicenseText" Visibility="Collapsed" Height="180" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" FontSize="11" Padding="12" Margin="0,10,0,0" AutomationProperties.Name="{loc:Text LicenseText}"/>
   </StackPanel></Border>
   <Border Style="{StaticResource Card}"><StackPanel>
    <TextBlock Text="{loc:Text UpdatesHeading}" FontSize="14" FontWeight="SemiBold"/>
    <TextBlock Text="{loc:Text UpdatesHint}" Style="{StaticResource Hint}" Margin="0,6,0,16"/>
    <WrapPanel><Button x:Name="UpdateButton" Content="{loc:Text CheckUpdates}" Click="CheckUpdatesClick" Margin="0,0,8,8"/><Button Content="{loc:Text CopyDiagnostics}" Click="CopyDiagnosticsClick" Margin="0,0,0,8"/></WrapPanel>
    <TextBlock x:Name="UpdateStatus" Style="{StaticResource Hint}" AutomationProperties.LiveSetting="Polite"/>
    <Button x:Name="DownloadButton" Content="{loc:Text OpenDownload}" Style="{StaticResource PrimaryButton}" Click="DownloadClick" Visibility="Collapsed" HorizontalAlignment="Left" Margin="0,12,0,0"/>
   </StackPanel></Border>
  </StackPanel></ScrollViewer>
 </Grid></Border>
</Window>
