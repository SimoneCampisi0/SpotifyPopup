<Window x:Class="SpotifyPopup.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework" Title="Spotify Popup" Icon="/Assets/logo.ico" Width="390" Height="260" MinWidth="330" MinHeight="240" WindowStyle="None" AllowsTransparency="True" Background="Transparent" Topmost="True" ResizeMode="CanResizeWithGrip" Loaded="OnLoaded" Closed="OnClosed" LocationChanged="OnLocationChanged" SizeChanged="OnSizeChanged" UseLayoutRounding="True" SnapsToDevicePixels="True">
 <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6" CornerRadius="18" GlassFrameThickness="0"/></shell:WindowChrome.WindowChrome>
 <Window.Resources>
  <Style x:Key="GlassButton" TargetType="Button"><Setter Property="Foreground" Value="#EAF6F3"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Surface" CornerRadius="20" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#36FFFFFF"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Background" Value="#55FFFFFF"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#FFFFFFFF"/><Setter TargetName="Surface" Property="BorderThickness" Value="2"/></Trigger><MultiTrigger><MultiTrigger.Conditions><Condition Property="Tag" Value="Primary"/><Condition Property="IsMouseOver" Value="True"/></MultiTrigger.Conditions><Setter TargetName="Surface" Property="Background" Value="#FFFFFFFF"/></MultiTrigger><MultiTrigger><MultiTrigger.Conditions><Condition Property="Tag" Value="Primary"/><Condition Property="IsPressed" Value="True"/></MultiTrigger.Conditions><Setter TargetName="Surface" Property="Background" Value="#FFC6E6D6"/></MultiTrigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="TrackToolTip" TargetType="ToolTip"><Setter Property="Background" Value="#F0242C2C"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="#50FFFFFF"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="12,8"/><Setter Property="MaxWidth" Value="400"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToolTip"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border></ControlTemplate></Setter.Value></Setter></Style>
 </Window.Resources>
 <Border x:Name="RootSurface" Margin="1" CornerRadius="18" BorderThickness="1" BorderBrush="#68FFFFFF" MouseLeftButtonDown="OnDrag">
  <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#F32F3D39" Offset="0"/><GradientStop Color="#F31C2626" Offset="0.52"/><GradientStop Color="#F20C1515" Offset="1"/></LinearGradientBrush></Border.Background>
  <Border.ContextMenu><ContextMenu><MenuItem Header="Chiudi" Click="ExitClick"/></ContextMenu></Border.ContextMenu>
  <Grid Margin="18,10,18,13"><Grid.RowDefinitions><RowDefinition Height="32"/><RowDefinition Height="*" MinHeight="76"/><RowDefinition Height="39"/><RowDefinition Height="53"/></Grid.RowDefinitions>
   <Grid Grid.Row="0"><Button Content="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="12" Style="{StaticResource GlassButton}" Width="30" Height="30" HorizontalAlignment="Left" ToolTip="Chiudi Spotify Popup" AutomationProperties.Name="Chiudi Spotify Popup" Click="ExitClick"/><Button Content="&#xE72E;" FontFamily="Segoe MDL2 Assets" Style="{StaticResource GlassButton}" Width="32" Height="32" HorizontalAlignment="Right" ToolTip="Blocca il popup" AutomationProperties.Name="Blocca il popup" Click="LockClick"/></Grid>
   <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="82"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Width="74" Height="74" CornerRadius="11" Background="#455F5553" HorizontalAlignment="Left" VerticalAlignment="Center" ClipToBounds="True"><Grid><TextBlock Text="♪" FontSize="29" Foreground="#9DD7C4" HorizontalAlignment="Center" VerticalAlignment="Center"/><Border CornerRadius="11" ClipToBounds="True"><Image x:Name="Cover" Stretch="UniformToFill"/></Border></Grid></Border>
    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="6,0,6,0"><TextBlock Text="NOW PLAYING" Foreground="#A8D5C6" FontSize="9" FontWeight="SemiBold" Margin="0,0,0,5"/><TextBlock x:Name="TitleText" Text="Apri Spotify" Foreground="#F8FFFFFF" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTipService.InitialShowDelay="350"><TextBlock.ToolTip><ToolTip Style="{StaticResource TrackToolTip}"><TextBlock MaxWidth="375" TextWrapping="Wrap" Text="{Binding PlacementTarget.Text, RelativeSource={RelativeSource AncestorType=ToolTip}}"/></ToolTip></TextBlock.ToolTip></TextBlock><TextBlock x:Name="ArtistText" Foreground="#C9E0D8" FontSize="12" Margin="0,5,0,0" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="AlbumText" Foreground="#98B7AE" FontSize="11" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/></StackPanel>
   </Grid>
   <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition Width="*"/><ColumnDefinition Width="34"/></Grid.ColumnDefinitions><TextBlock x:Name="ElapsedText" Text="0:00" Foreground="#AFD0C6" FontSize="10" VerticalAlignment="Center"/><Slider x:Name="Progress" Grid.Column="1" VerticalAlignment="Center" Margin="4,0" Minimum="0" Maximum="100" IsEnabled="False" IsMoveToPointEnabled="True" Foreground="#ABF5D1" PreviewMouseLeftButtonUp="Seek" ToolTip="Posizione del brano" AutomationProperties.Name="Posizione del brano"/><TextBlock x:Name="DurationText" Text="0:00" Grid.Column="2" Foreground="#AFD0C6" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid>
   <Grid Grid.Row="3" VerticalAlignment="Center">
    <Button x:Name="RestartButton" Content="&#xE777;" FontFamily="Segoe MDL2 Assets" FontSize="17" Width="44" Height="40" HorizontalAlignment="Left" VerticalAlignment="Center" IsEnabled="False" Style="{StaticResource GlassButton}" ToolTip="Riavvia brano da zero" AutomationProperties.Name="Riavvia brano da zero" Click="RestartClick"/>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center"><Button Content="&#xE892;" FontFamily="Segoe MDL2 Assets" FontSize="17" Width="44" Height="40" Style="{StaticResource GlassButton}" ToolTip="Brano precedente" AutomationProperties.Name="Brano precedente" Click="PreviousClick"/><Button x:Name="PlayButton" Tag="Primary" Content="&#xE768;" FontFamily="Segoe MDL2 Assets" FontSize="18" Width="46" Height="46" Margin="12,0" Style="{StaticResource GlassButton}" Background="#E8F7FFF9" Foreground="#10261E" ToolTip="Riproduci o metti in pausa" AutomationProperties.Name="Riproduci o metti in pausa" Click="PlayClick"/><Button Content="&#xE893;" FontFamily="Segoe MDL2 Assets" FontSize="17" Width="44" Height="40" Style="{StaticResource GlassButton}" ToolTip="Brano successivo" AutomationProperties.Name="Brano successivo" Click="NextClick"/></StackPanel>
   </Grid>
  </Grid>
 </Border>
</Window>

