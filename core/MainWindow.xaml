<Window x:Class="SpotifyPopup.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:loc="clr-namespace:SpotifyPopup" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
 Title="Spotify Popup" Icon="/SpotifyPopup;component/Assets/logo.ico" Width="420" Height="320" MinWidth="360" MinHeight="316"
 FontFamily="Segoe UI Variable Text, Segoe UI" Foreground="#F3F5F7" WindowStyle="None" AllowsTransparency="True" Background="Transparent" Topmost="True"
 ResizeMode="CanResizeWithGrip" Loaded="OnLoaded" Closed="OnClosed" SourceInitialized="OnSourceInitialized"
 MouseEnter="HoverChanged" MouseLeave="HoverChanged" IsKeyboardFocusWithinChanged="FocusWithinChanged"
 LocationChanged="OnLocationChanged" SizeChanged="OnSizeChanged" UseLayoutRounding="True" SnapsToDevicePixels="True">
 <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0"/></shell:WindowChrome.WindowChrome>
 <Window.Resources><ResourceDictionary>
  <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="Theme.xaml"/></ResourceDictionary.MergedDictionaries>
  <Style x:Key="MetadataText" TargetType="TextBlock">
   <Setter Property="Foreground" Value="#B9C3CD"/><Setter Property="TextTrimming" Value="CharacterEllipsis"/>
   <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}"/><Setter Property="ToolTipService.InitialShowDelay" Value="450"/>
  </Style>
  <DataTemplate x:Key="CoverArt"><Grid Width="96" Height="96">
   <Border CornerRadius="16" Background="#24FFFFFF" BorderBrush="#25FFFFFF" BorderThickness="1"/>
   <Path Data="M 12,2 L 12,21 C 10,18 3,19 3,24 C 3,29 14,29 14,23 L 14,8 L 25,5 L 25,18 C 23,15 16,16 16,21 C 16,26 27,26 27,20 L 27,0 Z" Fill="#A9B9C8" Width="28" Height="30" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
   <Image Source="{Binding Artwork}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"><Image.Clip><RectangleGeometry Rect="0,0,96,96" RadiusX="16" RadiusY="16"/></Image.Clip></Image>
  </Grid></DataTemplate>
 </ResourceDictionary></Window.Resources>
 <Border x:Name="RootSurface" Margin="1" CornerRadius="24" BorderThickness="1" MouseLeftButtonDown="OnDrag">
  <Border.BorderBrush><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#48FFFFFF"/><GradientStop Color="#16FFFFFF" Offset="1"/></LinearGradientBrush></Border.BorderBrush>
  <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop x:Name="BackgroundStart" Color="#FA1D1F23" Offset="0"/><GradientStop x:Name="BackgroundEnd" Color="#FA111317" Offset="1"/></LinearGradientBrush></Border.Background>
  <Border.ContextMenu><ContextMenu Style="{StaticResource DarkContextMenu}" ItemContainerStyle="{StaticResource {x:Type MenuItem}}" DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
   <MenuItem Header="{loc:Text Hide}" Click="HideClick"/>
   <Separator/>
   <MenuItem Header="{loc:Text LayoutNormal}" IsCheckable="True" IsChecked="{Binding IsNormalLayout, Mode=OneWay}" Click="NormalLayoutClick"/>
   <MenuItem Header="{loc:Text LayoutCompact}" IsCheckable="True" IsChecked="{Binding IsCompactLayout, Mode=OneWay}" Click="CompactLayoutClick"/>
   <MenuItem Header="{loc:Text LayoutEssential}" IsCheckable="True" IsChecked="{Binding IsEssentialLayout, Mode=OneWay}" Click="EssentialLayoutClick"/>
   <Separator/><MenuItem Header="{loc:Text Settings}" Click="SettingsClick"/><MenuItem Header="{loc:Text OpenSpotify}" Click="OpenSpotifyClick"/><MenuItem Header="{loc:Text LockPopup}" Click="LockClick"/>
   <Separator/><MenuItem Header="{loc:Text Exit}" Click="ExitClick"/>
  </ContextMenu></Border.ContextMenu>
  <Grid Margin="18,12,18,14">
   <Grid.RowDefinitions><RowDefinition Height="32"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid Opacity="{Binding HeaderOpacity}">
    <Button x:Name="MenuButton" Style="{StaticResource QuietButton}" Padding="0" MinHeight="32" HorizontalAlignment="Left" Click="OpenMenuClick" ToolTip="{loc:Text MoreActions}" AutomationProperties.Name="{loc:Text MoreActions}">
     <StackPanel Orientation="Horizontal"><Image Source="/SpotifyPopup;component/Assets/logo.ico" Width="18" Height="18" Margin="0,0,8,0"/>
      <StackPanel VerticalAlignment="Center"><TextBlock Text="Spotify Popup" FontSize="11" FontWeight="SemiBold" Foreground="#E1E7EC"/><TextBlock Text="{Binding Player.Status}" FontSize="10" Foreground="#AEBAC6"/></StackPanel>
      <Path Data="M 0,0 L 3,3 L 6,0" Stroke="#AEBAC6" StrokeThickness="1.2" VerticalAlignment="Center" Margin="8,0,0,0"/>
     </StackPanel>
    </Button>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
     <Button x:Name="SettingsButton" Content="&#xE713;" Style="{StaticResource GlassButton}" Click="SettingsClick" ToolTip="{loc:Text Settings}" AutomationProperties.Name="{loc:Text Settings}" /><Button x:Name="LockButton" Content="&#xE72E;" Style="{StaticResource GlassButton}" Click="LockClick" ToolTip="{loc:Text LockPopup}" AutomationProperties.Name="{loc:Text LockPopup}" /><Button  Content="&#xE8BB;" Style="{StaticResource GlassButton}" Click="ExitClick" ToolTip="{loc:Text ExitPopup}" AutomationProperties.Name="{loc:Text ExitPopup}" />
    </StackPanel>
   </Grid>
   <Grid x:Name="NormalLayout" Grid.Row="1" Margin="0,12,0,0">
    <Grid.RowDefinitions><RowDefinition Height="*" MinHeight="108"/><RowDefinition Height="38"/><RowDefinition Height="56"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid x:Name="NormalMetadata" VerticalAlignment="Center"><Grid.ColumnDefinitions><ColumnDefinition Width="116"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <ContentControl Content="{Binding Player}" ContentTemplate="{StaticResource CoverArt}" HorizontalAlignment="Left"/>
     <StackPanel Grid.Column="1" VerticalAlignment="Center">
      <TextBlock x:Name="NormalTitle" Text="{Binding Player.Title}" Style="{StaticResource MetadataText}" Foreground="White" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap" LineHeight="27" MaxHeight="54"/>
      <TextBlock Text="{Binding Player.Artist}" Style="{StaticResource MetadataText}" FontSize="13" Margin="0,8,0,0"/>
      <TextBlock Text="{Binding Player.Album}" Style="{StaticResource MetadataText}" FontSize="11" Foreground="#B2BCC6" Margin="0,4,0,0" Visibility="{Binding AlbumVisibility}"/>
     </StackPanel>
    </Grid>
    <Grid Grid.Row="1"><Grid.RowDefinitions><RowDefinition Height="22"/><RowDefinition Height="16"/></Grid.RowDefinitions>
     <Slider x:Name="NormalProgress" Minimum="0" Maximum="100" IsMoveToPointEnabled="True" SmallChange="1" LargeChange="10" IsEnabled="{Binding Player.CanSeek}" PreviewMouseLeftButtonDown="SeekMouseDown" PreviewMouseLeftButtonUp="SeekMouseUp" LostMouseCapture="SeekCaptureLost" PreviewKeyDown="SeekKeyDown" PreviewKeyUp="SeekKeyUp" LostKeyboardFocus="SeekKeyboardFocusLost" ValueChanged="SeekValueChanged" ToolTip="{loc:Text TrackPosition}" AutomationProperties.Name="{loc:Text TrackPosition}"/>
     <TextBlock x:Name="NormalElapsed" Grid.Row="1" Text="{Binding Player.Elapsed}" FontSize="10" Foreground="#B9C3CD"/>
     <TextBlock Grid.Row="1" Text="{Binding Player.Duration}" FontSize="10" Foreground="#B9C3CD" HorizontalAlignment="Right"/>
    </Grid>
    <Grid Grid.Row="2" VerticalAlignment="Center">
     <Button  Content="&#xE777;" Style="{StaticResource GlassButton}" Click="RestartClick" ToolTip="{loc:Text RestartTrack}" AutomationProperties.Name="{loc:Text RestartTrack}" HorizontalAlignment="Left" IsEnabled="{Binding Player.CanSeek}" Foreground="#B9C3CD"/>
     <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
      <Button x:Name="PreviousButton" Content="&#xE892;" Style="{StaticResource GlassButton}" Click="PreviousClick" ToolTip="{loc:Text PreviousTrack}" AutomationProperties.Name="{loc:Text PreviousTrack}" Width="36" Height="40" IsEnabled="{Binding Player.CanPrevious}"/><Border Width="14"/><Button x:Name="PlayButton" Content="{Binding Player.PlayGlyph}" Tag="Primary" Style="{StaticResource GlassButton}" Width="52" Height="52" FontSize="20" Background="#A9EACB" Foreground="#10251D" IsEnabled="{Binding Player.CanPlayPause}" ToolTip="{Binding Player.PlayLabel}" AutomationProperties.Name="{Binding Player.PlayLabel}" Click="PlayClick"/><Border Width="14"/><Button x:Name="NextButton" Content="&#xE893;" Style="{StaticResource GlassButton}" Click="NextClick" ToolTip="{loc:Text NextTrack}" AutomationProperties.Name="{loc:Text NextTrack}" Width="36" Height="40" IsEnabled="{Binding Player.CanNext}"/>
     </StackPanel>
    </Grid>
    <Button Grid.Row="3" Content="{loc:Text OpenSpotify}" Style="{StaticResource PrimaryButton}" MinHeight="36" Padding="12,8" Margin="0,8,0,0" Visibility="{Binding OpenSpotifyVisibility}" AutomationProperties.Name="{loc:Text OpenSpotify}" Click="OpenSpotifyClick"/>
   </Grid>
   <Grid x:Name="CompactLayout" Grid.Row="1" Visibility="Collapsed" Margin="0,8,0,0">
    <Grid.RowDefinitions><RowDefinition Height="*" MinHeight="56"/><RowDefinition Height="26"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="66"/><ColumnDefinition Width="*"/><ColumnDefinition Width="100"/></Grid.ColumnDefinitions>
     <Viewbox Width="52" Height="52" HorizontalAlignment="Left"><ContentControl Content="{Binding Player}" ContentTemplate="{StaticResource CoverArt}"/></Viewbox>
     <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0"><TextBlock Text="{Binding Player.Title}" Style="{StaticResource MetadataText}" Foreground="White" FontSize="14" FontWeight="SemiBold"/>
      <TextBlock Text="{Binding Player.Artist}" Style="{StaticResource MetadataText}" FontSize="11" Margin="0,5,0,0"/>
      <TextBlock Text="{Binding Player.Album}" Style="{StaticResource MetadataText}" FontSize="10" Foreground="#B2BCC6" Visibility="{Binding AlbumVisibility}"/>
     </StackPanel>
     <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"><Button  Content="&#xE892;" Style="{StaticResource GlassButton}" Click="PreviousClick" ToolTip="{loc:Text PreviousTrack}" AutomationProperties.Name="{loc:Text PreviousTrack}" Width="30" IsEnabled="{Binding Player.CanPrevious}"/><Button  Content="{Binding Player.PlayGlyph}" Tag="Primary" Style="{StaticResource GlassButton}" Width="40" Height="40" FontSize="16" Background="#A9EACB" Foreground="#10251D" IsEnabled="{Binding Player.CanPlayPause}" ToolTip="{Binding Player.PlayLabel}" AutomationProperties.Name="{Binding Player.PlayLabel}" Click="PlayClick"/><Button  Content="&#xE893;" Style="{StaticResource GlassButton}" Click="NextClick" ToolTip="{loc:Text NextTrack}" AutomationProperties.Name="{loc:Text NextTrack}" Width="30" IsEnabled="{Binding Player.CanNext}"/></StackPanel>
    </Grid>
    <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition Width="*"/><ColumnDefinition Width="36"/></Grid.ColumnDefinitions>
     <TextBlock x:Name="CompactElapsed" Text="{Binding Player.Elapsed}" Foreground="#B9C3CD" FontSize="10" VerticalAlignment="Center"/>
     <Slider x:Name="CompactProgress" Grid.Column="1" Minimum="0" Maximum="100" IsMoveToPointEnabled="True" SmallChange="1" LargeChange="10" Margin="4,0" IsEnabled="{Binding Player.CanSeek}" PreviewMouseLeftButtonDown="SeekMouseDown" PreviewMouseLeftButtonUp="SeekMouseUp" LostMouseCapture="SeekCaptureLost" PreviewKeyDown="SeekKeyDown" PreviewKeyUp="SeekKeyUp" LostKeyboardFocus="SeekKeyboardFocusLost" ValueChanged="SeekValueChanged" ToolTip="{loc:Text TrackPosition}" AutomationProperties.Name="{loc:Text TrackPosition}"/>
     <TextBlock Grid.Column="2" Text="{Binding Player.Duration}" Foreground="#B9C3CD" FontSize="10" VerticalAlignment="Center" HorizontalAlignment="Right"/>
    </Grid>
    <Button Grid.Row="2" Content="{loc:Text OpenSpotify}" Style="{StaticResource PrimaryButton}" MinHeight="32" Padding="10,6" Margin="0,6,0,0" Visibility="{Binding OpenSpotifyVisibility}" Click="OpenSpotifyClick"/>
   </Grid>
   <Grid x:Name="EssentialLayout" Grid.Row="1" Visibility="Collapsed" MinHeight="48" Margin="0,6,0,0">
    <Grid.ColumnDefinitions><ColumnDefinition Width="52"/><ColumnDefinition Width="*"/><ColumnDefinition Width="38"/></Grid.ColumnDefinitions>
    <Viewbox Width="42" Height="42" HorizontalAlignment="Left"><ContentControl Content="{Binding Player}" ContentTemplate="{StaticResource CoverArt}"/></Viewbox>
    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0"><TextBlock Text="{Binding Player.Title}" Style="{StaticResource MetadataText}" Foreground="White" FontSize="13" FontWeight="SemiBold"/><TextBlock Text="{Binding Player.Artist}" Style="{StaticResource MetadataText}" FontSize="11" Margin="0,3,0,0"/></StackPanel>
    <Button Grid.Column="2"  Content="{Binding Player.PlayGlyph}" Tag="Primary" Style="{StaticResource GlassButton}" Width="36" Height="36" FontSize="16" Background="#A9EACB" Foreground="#10251D" IsEnabled="{Binding Player.CanPlayPause}" ToolTip="{Binding Player.PlayLabel}" AutomationProperties.Name="{Binding Player.PlayLabel}" Click="PlayClick"/>
   </Grid>
   <Border Grid.Row="2" Background="#20FFD28C" CornerRadius="10" Padding="10,8" Margin="0,10,0,0" Visibility="{Binding NoticeVisibility}">
    <TextBlock Text="{Binding Player.Notice}" Foreground="#FFE0AC" FontSize="11" TextWrapping="Wrap" MaxHeight="44" ToolTip="{Binding Player.Notice}" AutomationProperties.LiveSetting="Polite"/>
   </Border>
  </Grid>
 </Border>
</Window>
