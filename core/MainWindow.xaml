<Window x:Class="SpotifyPopup.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:loc="clr-namespace:SpotifyPopup"
 xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
 Title="Spotify Popup" Icon="/SpotifyPopup;component/Assets/logo.ico" Width="390" Height="270" MinWidth="330" MinHeight="255"
 WindowStyle="None" AllowsTransparency="True" Background="Transparent" Topmost="True"
 ResizeMode="CanResizeWithGrip" Loaded="OnLoaded" Closed="OnClosed" SourceInitialized="OnSourceInitialized"
 MouseEnter="HoverChanged" MouseLeave="HoverChanged" IsKeyboardFocusWithinChanged="HoverChanged" LocationChanged="OnLocationChanged" SizeChanged="OnSizeChanged" UseLayoutRounding="True" SnapsToDevicePixels="True">
 <shell:WindowChrome.WindowChrome>
  <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6" CornerRadius="18" GlassFrameThickness="0"/>
 </shell:WindowChrome.WindowChrome>
 <Window.Resources>
  <BooleanToVisibilityConverter x:Key="VisibleWhenTrue"/>
  <Style x:Key="GlassButton" TargetType="Button">
   <Setter Property="Foreground" Value="#EAF6F3"/><Setter Property="Background" Value="Transparent"/>
   <Setter Property="BorderThickness" Value="0"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/><Setter Property="Width" Value="36"/><Setter Property="Height" Value="32"/>
   <Setter Property="FontSize" Value="14"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border x:Name="Surface" CornerRadius="15" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
     <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#36FFFFFF"/></Trigger>
     <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Background" Value="#55FFFFFF"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="White"/><Setter TargetName="Surface" Property="BorderThickness" Value="2"/></Trigger>
     <MultiTrigger><MultiTrigger.Conditions><Condition Property="Tag" Value="Primary"/><Condition Property="IsMouseOver" Value="True"/></MultiTrigger.Conditions><Setter TargetName="Surface" Property="Background" Value="White"/></MultiTrigger>
     <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.35"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="MetadataText" TargetType="TextBlock">
   <Setter Property="Foreground" Value="#D0E4DB"/><Setter Property="TextTrimming" Value="CharacterEllipsis"/>
   <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}"/>
   <Setter Property="ToolTipService.InitialShowDelay" Value="350"/>
  </Style>
  <Style TargetType="ToolTip">
   <Setter Property="MaxWidth" Value="400"/><Setter Property="Foreground" Value="White"/><Setter Property="Background" Value="#F0242C2C"/>
   <Setter Property="BorderBrush" Value="#60FFFFFF"/><Setter Property="Padding" Value="12,8"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToolTip">
    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="{TemplateBinding Padding}">
     <TextBlock Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}" TextWrapping="Wrap" MaxWidth="375"/>
    </Border>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <DataTemplate x:Key="TrackInfo">
   <StackPanel VerticalAlignment="Center">
    <TextBlock Text="{Binding Status}" Foreground="#A8D5C6" FontSize="10" FontWeight="SemiBold" Margin="0,0,0,4"/>
    <TextBlock Text="{Binding Title}" Style="{StaticResource MetadataText}" Foreground="White" FontSize="16" FontWeight="SemiBold"/>
    <TextBlock Text="{Binding Artist}" Style="{StaticResource MetadataText}" FontSize="12" Margin="0,4,0,0"/>
    <TextBlock Text="{Binding Album}" Style="{StaticResource MetadataText}" Foreground="#ACCDC0" FontSize="11" Margin="0,3,0,0" Visibility="{Binding AlbumVisibility, RelativeSource={RelativeSource AncestorType=Window}}"/>
   </StackPanel>
  </DataTemplate>
  <DataTemplate x:Key="CoverArt">
   <Grid Width="74" Height="74">
    <Border CornerRadius="11" Background="#455F5553"/>
    <TextBlock Text="♪" FontSize="29" Foreground="#9DD7C4" HorizontalAlignment="Center" VerticalAlignment="Center"/>
    <Image Source="{Binding Artwork}" Stretch="UniformToFill"><Image.Clip><RectangleGeometry Rect="0,0,74,74" RadiusX="11" RadiusY="11"/></Image.Clip></Image>
   </Grid>
  </DataTemplate>
 </Window.Resources>
 <Border x:Name="RootSurface" Margin="1" CornerRadius="18" BorderThickness="1" BorderBrush="#68FFFFFF" MouseLeftButtonDown="OnDrag">
  <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop x:Name="BackgroundStart" Color="#F32F3D39" Offset="0"/><GradientStop x:Name="BackgroundEnd" Color="#F30C1515" Offset="1"/></LinearGradientBrush></Border.Background>
  <Border.ContextMenu><ContextMenu>
   <MenuItem Header="{loc:Text Hide}" Click="HideClick"/>
   <MenuItem Header="{loc:Text SwitchLayout}" Click="CompactClick"/><MenuItem Header="{loc:Text EssentialMode}" Click="EssentialClick"/>
   <MenuItem Header="{loc:Text Settings}" Click="SettingsClick"/>
   <Separator/><MenuItem Header="{loc:Text Exit}" Click="ExitClick"/>
  </ContextMenu></Border.ContextMenu>
  <Grid Margin="14,8,14,10">
   <Grid.RowDefinitions><RowDefinition Height="32"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid Opacity="{Binding HeaderOpacity}">
    <Button Content="&#xE8BB;" Style="{StaticResource GlassButton}" HorizontalAlignment="Left" ToolTip="{loc:Text ExitPopup}" AutomationProperties.Name="{loc:Text ExitPopup}" Click="ExitClick"/>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
     <Button Content="&#xE8A7;" Style="{StaticResource GlassButton}" ToolTip="{loc:Text SwitchLayoutHint}" AutomationProperties.Name="{loc:Text SwitchLayoutHint}" Click="CompactClick"/>
     <Button x:Name="SettingsButton" Content="&#xE713;" Style="{StaticResource GlassButton}" ToolTip="{loc:Text Settings}" AutomationProperties.Name="{loc:Text Settings}" Click="SettingsClick"/>
     <Button x:Name="LockButton" Content="&#xE72E;" Style="{StaticResource GlassButton}" Width="32" ToolTip="{loc:Text LockPopup}" AutomationProperties.Name="{loc:Text LockPopup}" Click="LockClick"/>
    </StackPanel>
   </Grid>
   <Viewbox x:Name="NormalLayout" Grid.Row="1" Stretch="Uniform">
    <Grid Width="350" Height="205">
     <Grid.RowDefinitions><RowDefinition Height="90"/><RowDefinition Height="37"/><RowDefinition Height="53"/><RowDefinition Height="25"/></Grid.RowDefinitions>
     <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="88"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <ContentControl Content="{Binding Player}" ContentTemplate="{StaticResource CoverArt}" HorizontalAlignment="Left"/>
      <ContentControl Grid.Column="1" Content="{Binding Player}" ContentTemplate="{StaticResource TrackInfo}"/>
     </Grid>
     <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/><ColumnDefinition Width="48"/></Grid.ColumnDefinitions>
      <TextBlock x:Name="NormalElapsed" Text="{Binding Player.Elapsed}" Foreground="#C2DFD2" FontSize="11" VerticalAlignment="Center"/>
      <Slider x:Name="NormalProgress" Grid.Column="1" Margin="4,0" VerticalAlignment="Center" Minimum="0" Maximum="100" IsMoveToPointEnabled="True" SmallChange="1" LargeChange="10"
       IsEnabled="{Binding Player.CanSeek}" PreviewMouseLeftButtonDown="SeekMouseDown" PreviewMouseLeftButtonUp="SeekMouseUp" LostMouseCapture="SeekCaptureLost" PreviewKeyDown="SeekKeyDown" PreviewKeyUp="SeekKeyUp" LostKeyboardFocus="SeekKeyboardFocusLost" ValueChanged="SeekValueChanged"
       ToolTip="{loc:Text TrackPosition}" AutomationProperties.Name="{loc:Text TrackPosition}"/>
      <TextBlock Grid.Column="2" Text="{Binding Player.Duration}" Foreground="#C2DFD2" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center"/>
     </Grid>
     <Grid Grid.Row="2" VerticalAlignment="Center">
      <Button Content="&#xE777;" Style="{StaticResource GlassButton}" HorizontalAlignment="Left" Width="40" Height="40" IsEnabled="{Binding Player.CanSeek}" ToolTip="{loc:Text RestartTrack}" AutomationProperties.Name="{loc:Text RestartTrack}" Click="RestartClick"/>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
       <Button x:Name="PreviousButton" Content="&#xE892;" Style="{StaticResource GlassButton}" Width="42" Height="42" IsEnabled="{Binding Player.CanPrevious}" ToolTip="{loc:Text PreviousTrack}" AutomationProperties.Name="{loc:Text PreviousTrack}" Click="PreviousClick"/>
       <Button x:Name="PlayButton" Content="{Binding Player.PlayGlyph}" Tag="Primary" Style="{StaticResource GlassButton}" Width="46" Height="46" Margin="12,0" Background="#E8F7FFF9" Foreground="#10261E" FontSize="18" IsEnabled="{Binding Player.CanPlayPause}" ToolTip="{Binding Player.PlayLabel}" AutomationProperties.Name="{Binding Player.PlayLabel}" Click="PlayClick"/>
       <Button x:Name="NextButton" Content="&#xE893;" Style="{StaticResource GlassButton}" Width="42" Height="42" IsEnabled="{Binding Player.CanNext}" ToolTip="{loc:Text NextTrack}" AutomationProperties.Name="{loc:Text NextTrack}" Click="NextClick"/>
      </StackPanel>
     </Grid>
     <Button Grid.Row="3" Content="{loc:Text OpenSpotify}" FontFamily="Segoe UI" Style="{StaticResource GlassButton}" Width="115" Height="25" FontSize="11" Visibility="{Binding OpenSpotifyVisibility}" AutomationProperties.Name="{loc:Text OpenSpotify}" Click="OpenSpotifyClick"/>
    </Grid>
   </Viewbox>
   <Grid x:Name="CompactLayout" Grid.Row="1" Visibility="Collapsed">
    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="28"/></Grid.RowDefinitions>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="52"/><ColumnDefinition Width="*"/><ColumnDefinition Width="128"/></Grid.ColumnDefinitions>
     <Viewbox Width="44" Height="44" HorizontalAlignment="Left"><ContentControl Content="{Binding Player}" ContentTemplate="{StaticResource CoverArt}"/></Viewbox>
     <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0">
      <TextBlock Text="{Binding Player.Title}" Style="{StaticResource MetadataText}" Foreground="White" FontSize="12" FontWeight="SemiBold"/>
      <TextBlock Text="{Binding Player.Artist}" Style="{StaticResource MetadataText}" FontSize="10" Margin="0,2,0,0"/>
      <TextBlock Text="{Binding Player.Album}" Style="{StaticResource MetadataText}" FontSize="9" Foreground="#ACCDC0" Visibility="{Binding AlbumVisibility}"/>
      <TextBlock Text="{Binding Player.Status}" Foreground="#A8D5C6" FontSize="9"/>
     </StackPanel>
     <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
      <Button Content="&#xE777;" Style="{StaticResource GlassButton}" Width="30" IsEnabled="{Binding Player.CanSeek}" ToolTip="{loc:Text RestartTrack}" AutomationProperties.Name="{loc:Text RestartTrack}" Click="RestartClick"/>
      <Button Content="&#xE892;" Style="{StaticResource GlassButton}" Width="30" IsEnabled="{Binding Player.CanPrevious}" ToolTip="{loc:Text PreviousTrack}" AutomationProperties.Name="{loc:Text PreviousTrack}" Click="PreviousClick"/>
      <Button Content="{Binding Player.PlayGlyph}" Style="{StaticResource GlassButton}" Width="36" Tag="Primary" Background="#E8F7FFF9" Foreground="#10261E" IsEnabled="{Binding Player.CanPlayPause}" ToolTip="{Binding Player.PlayLabel}" AutomationProperties.Name="{Binding Player.PlayLabel}" Click="PlayClick"/>
      <Button Content="&#xE893;" Style="{StaticResource GlassButton}" Width="30" IsEnabled="{Binding Player.CanNext}" ToolTip="{loc:Text NextTrack}" AutomationProperties.Name="{loc:Text NextTrack}" Click="NextClick"/>
     </StackPanel>
    </Grid>
    <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="45"/><ColumnDefinition Width="*"/><ColumnDefinition Width="45"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <TextBlock x:Name="CompactElapsed" Text="{Binding Player.Elapsed}" Foreground="#C2DFD2" FontSize="10" VerticalAlignment="Center"/>
     <Slider x:Name="CompactProgress" Grid.Column="1" Margin="3,0" VerticalAlignment="Center" Minimum="0" Maximum="100" IsMoveToPointEnabled="True" SmallChange="1" LargeChange="10"
      IsEnabled="{Binding Player.CanSeek}" PreviewMouseLeftButtonDown="SeekMouseDown" PreviewMouseLeftButtonUp="SeekMouseUp" LostMouseCapture="SeekCaptureLost" PreviewKeyDown="SeekKeyDown" PreviewKeyUp="SeekKeyUp" LostKeyboardFocus="SeekKeyboardFocusLost" ValueChanged="SeekValueChanged"
      ToolTip="{loc:Text TrackPosition}" AutomationProperties.Name="{loc:Text TrackPosition}"/>
     <TextBlock Grid.Column="2" Text="{Binding Player.Duration}" Foreground="#C2DFD2" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Center"/>
     <Button Grid.Column="3" Content="{loc:Text OpenSpotify}" FontFamily="Segoe UI" Style="{StaticResource GlassButton}" Width="88" Height="24" FontSize="10" Margin="4,0,0,0" Visibility="{Binding OpenSpotifyVisibility}" AutomationProperties.Name="{loc:Text OpenSpotify}" Click="OpenSpotifyClick"/>
    </Grid>
   </Grid>
   <Grid x:Name="EssentialLayout" Grid.Row="1" Visibility="Collapsed" MinHeight="44">
    <Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/><ColumnDefinition Width="40"/></Grid.ColumnDefinitions>
    <Viewbox Width="40" Height="40"><ContentControl Content="{Binding Player}" ContentTemplate="{StaticResource CoverArt}"/></Viewbox>
    <TextBlock Grid.Column="1" Text="{Binding Player.Title}" Style="{StaticResource MetadataText}" FontSize="12" VerticalAlignment="Center" Margin="4,0,8,0"/>
    <Button Grid.Column="2" Content="{Binding Player.PlayGlyph}" Style="{StaticResource GlassButton}" IsEnabled="{Binding Player.CanPlayPause}" ToolTip="{Binding Player.PlayLabel}" AutomationProperties.Name="{Binding Player.PlayLabel}" Click="PlayClick"/>
   </Grid>
   <TextBlock Grid.Row="2" Text="{Binding Player.Notice}" Visibility="{Binding NoticeVisibility}" Foreground="#FFE4B2" FontSize="10" Margin="0,3,0,0" TextWrapping="Wrap" MaxHeight="30" ToolTip="{Binding Player.Notice}" AutomationProperties.LiveSetting="Polite"/>
  </Grid>
 </Border>
</Window>
