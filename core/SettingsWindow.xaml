<Window x:Class="SpotifyPopup.SettingsWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:loc="clr-namespace:SpotifyPopup"
 Title="{loc:Text SettingsTitle}" Width="540" Height="740" MinWidth="460" MinHeight="540" WindowStartupLocation="CenterOwner"
 Background="#172522" Foreground="#EAF6F3" ShowInTaskbar="False" ResizeMode="CanResize" Icon="/SpotifyPopup;component/Assets/logo.ico">
 <Window.Resources>
  <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#EAF6F3"/></Style>
  <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#EAF6F3"/><Setter Property="Margin" Value="0,0,0,12"/></Style>
  <Style TargetType="TextBox"><Setter Property="Padding" Value="8,6"/><Setter Property="Background" Value="#2E423B"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="#7A9A8A"/></Style>
  <Style TargetType="Button"><Setter Property="Padding" Value="16,7"/><Setter Property="Margin" Value="8,0,0,0"/></Style>
  <Style x:Key="AboutLink" TargetType="Button">
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border x:Name="LinkSurface" Padding="{TemplateBinding Padding}" BorderBrush="Transparent" BorderThickness="1" CornerRadius="3">
     <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="White"/><Setter TargetName="LinkSurface" Property="Background" Value="#203F6552"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="LinkSurface" Property="BorderBrush" Value="White"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
 </Window.Resources>
 <Grid Margin="24">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <TextBlock Text="{loc:Text SettingsHeading}" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,20"/>
  <ScrollViewer x:Name="SettingsScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
   <StackPanel>
<TextBlock Text="{loc:Text StartupHeading}" FontSize="16" FontWeight="SemiBold" Margin="0,16,0,12"/><CheckBox x:Name="StartupBox" Content="{loc:Text StartWithWindows}" AutomationProperties.Name="{loc:Text StartWithWindows}"/><CheckBox x:Name="TrayBox" Content="{loc:Text StartInTray}" AutomationProperties.Name="{loc:Text StartInTray}"/><TextBlock Text="{loc:Text StartupHint}" TextWrapping="Wrap" Foreground="#B7CEC2" FontSize="11" Margin="0,0,0,12"/><TextBlock Text="{loc:Text Appearance}" FontSize="16" FontWeight="SemiBold" Margin="0,16,0,12"/>
    <Label Target="{Binding ElementName=LanguageBox}" Foreground="#EAF6F3" Padding="0" Content="{loc:Text Language}"/>
    <ComboBox x:Name="LanguageBox" SelectedValuePath="Tag" Margin="0,6,0,0" Padding="8,6" Foreground="#10261E" Background="#EAF6F3" AutomationProperties.Name="{loc:Text Language}">
     <ComboBoxItem Tag="auto" Content="{loc:Text SystemLanguage}"/>
     <ComboBoxItem Tag="en" Content="English"/>
     <ComboBoxItem Tag="it" Content="Italiano"/>
    </ComboBox>
    <TextBlock Text="{loc:Text LanguageHint}" FontSize="11" Foreground="#B7CEC2" TextWrapping="Wrap" Margin="0,3,0,15"/>
    <CheckBox x:Name="ShowAlbumBox" Content="{loc:Text ShowAlbum}" AutomationProperties.Name="{loc:Text ShowAlbum}"/>
    <CheckBox x:Name="SnapBox" Content="{loc:Text SnapEdges}" AutomationProperties.Name="{loc:Text SnapEdges}"/>
    <Label Target="{Binding ElementName=OpacitySlider}" Foreground="#EAF6F3" Padding="0" Content="{loc:Text LockedOpacity}"/>
    <Grid Margin="0,7,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="48"/></Grid.ColumnDefinitions>
     <Slider x:Name="OpacitySlider" Minimum="25" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="OpacityChanged" AutomationProperties.Name="{loc:Text LockedOpacity}"/>
     <TextBlock x:Name="OpacityValue" Grid.Column="1" HorizontalAlignment="Right"/>
    </Grid>
    <TextBlock Text="{loc:Text OpacityHint}" FontSize="11" Foreground="#B7CEC2" TextWrapping="Wrap" Margin="0,3,0,15"/>
    <Label Target="{Binding ElementName=ToggleBox}" Foreground="#EAF6F3" Padding="0" Content="{loc:Text ToggleShortcut}"/>
    <TextBox x:Name="ToggleBox" Margin="0,6,0,12" AutomationProperties.Name="{loc:Text ToggleShortcut}"/>
    <Label Target="{Binding ElementName=UnlockBox}" Foreground="#EAF6F3" Padding="0" Content="{loc:Text UnlockShortcut}"/>
    <TextBox x:Name="UnlockBox" Margin="0,6,0,7" AutomationProperties.Name="{loc:Text UnlockShortcut}"/>
    <TextBlock Text="{loc:Text ShortcutHint}" FontSize="11" Foreground="#B7CEC2" TextWrapping="Wrap"/>
<TextBlock Text="{loc:Text Appearance}" FontSize="16" FontWeight="SemiBold" Margin="0,16,0,12"/><Label Target="{Binding ElementName=BackgroundBox}" Content="{loc:Text BackgroundMode}" Foreground="#EAF6F3" Padding="0"/>
<ComboBox x:Name="BackgroundBox" SelectedValuePath="Tag" Margin="0,6,0,12" Padding="8,6" AutomationProperties.Name="{loc:Text BackgroundMode}">
<ComboBoxItem Tag="artwork" Content="{loc:Text ArtworkBackground}"/><ComboBoxItem Tag="fixed" Content="{loc:Text FixedBackground}"/><ComboBoxItem Tag="custom" Content="{loc:Text CustomBackground}"/>
</ComboBox><Label Target="{Binding ElementName=ColorBox}" Content="{loc:Text BackgroundColor}" Foreground="#EAF6F3" Padding="0"/><TextBox x:Name="ColorBox" AutomationProperties.Name="{loc:Text BackgroundColor}" Margin="0,6,0,12"/><TextBlock Text="{loc:Text ColorHint}" TextWrapping="Wrap" Foreground="#B7CEC2" FontSize="11" Margin="0,0,0,12"/><CheckBox x:Name="AnimationBox" Content="{loc:Text AnimateBackground}" AutomationProperties.Name="{loc:Text AnimateBackground}"/><TextBlock Text="{loc:Text VisibilityHeading}" FontSize="16" FontWeight="SemiBold" Margin="0,16,0,12"/><CheckBox x:Name="DisconnectedBox" Content="{loc:Text HideDisconnected}" AutomationProperties.Name="{loc:Text HideDisconnected}"/><CheckBox x:Name="PausedBox" Content="{loc:Text HidePaused}" AutomationProperties.Name="{loc:Text HidePaused}"/><Label Target="{Binding ElementName=DelayBox}" Content="{loc:Text PauseDelay}" Foreground="#EAF6F3" Padding="0"/><TextBox x:Name="DelayBox" AutomationProperties.Name="{loc:Text PauseDelay}" Margin="0,6,0,12"/><TextBlock Text="{loc:Text VisibilityHint}" TextWrapping="Wrap" Foreground="#B7CEC2" FontSize="11" Margin="0,0,0,12"/><TextBlock Text="{loc:Text PlaybackShortcuts}" FontSize="16" FontWeight="SemiBold" Margin="0,16,0,12"/><Label Target="{Binding ElementName=PlayBox}" Content="{loc:Text PlayShortcut}" Foreground="#EAF6F3" Padding="0"/><TextBox x:Name="PlayBox" AutomationProperties.Name="{loc:Text PlayShortcut}" Margin="0,6,0,12"/><Label Target="{Binding ElementName=PreviousBox}" Content="{loc:Text PreviousShortcut}" Foreground="#EAF6F3" Padding="0"/><TextBox x:Name="PreviousBox" AutomationProperties.Name="{loc:Text PreviousShortcut}" Margin="0,6,0,12"/><Label Target="{Binding ElementName=NextBox}" Content="{loc:Text NextShortcut}" Foreground="#EAF6F3" Padding="0"/><TextBox x:Name="NextBox" AutomationProperties.Name="{loc:Text NextShortcut}" Margin="0,6,0,12"/><Label Target="{Binding ElementName=BackwardBox}" Content="{loc:Text BackwardShortcut}" Foreground="#EAF6F3" Padding="0"/><TextBox x:Name="BackwardBox" AutomationProperties.Name="{loc:Text BackwardShortcut}" Margin="0,6,0,12"/><Label Target="{Binding ElementName=ForwardBox}" Content="{loc:Text ForwardShortcut}" Foreground="#EAF6F3" Padding="0"/><TextBox x:Name="ForwardBox" AutomationProperties.Name="{loc:Text ForwardShortcut}" Margin="0,6,0,12"/><TextBlock Text="{loc:Text OptionalShortcutHint}" TextWrapping="Wrap" Foreground="#B7CEC2" FontSize="11" Margin="0,0,0,12"/><TextBlock Text="{loc:Text RecoveryHeading}" FontSize="16" FontWeight="SemiBold" Margin="0,16,0,12"/><Button Content="{loc:Text ResetPlacement}" Click="ResetPlacementClick" HorizontalAlignment="Left" Margin="0,0,0,8"/><TextBlock Text="{loc:Text ResetPlacementHint}" TextWrapping="Wrap" Foreground="#B7CEC2" FontSize="11" Margin="0,0,0,12"/><Button Content="{loc:Text ResetAll}" Click="ResetAllClick" HorizontalAlignment="Left" Margin="0,0,0,12"/>
    <TextBlock x:Name="ErrorText" Foreground="#FFE4B2" FontSize="12" TextWrapping="Wrap" Margin="0,12,0,0" AutomationProperties.LiveSetting="Assertive"/>
   </StackPanel>
  </ScrollViewer>
  <Grid Grid.Row="2" Margin="0,18,0,0">
   <Button x:Name="AboutButton" Content="{loc:Text About}" Style="{StaticResource AboutLink}" Click="AboutClick" HorizontalAlignment="Left" VerticalAlignment="Center"
    Padding="2,6" Margin="0" Foreground="#C0D8CB" Background="Transparent" BorderThickness="0" Cursor="Hand" FontSize="12"
    AutomationProperties.Name="{loc:Text AboutTitle}"/>
  <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
   <Button Content="{loc:Text Cancel}" IsCancel="True" Click="CancelClick"/>
   <Button Content="{loc:Text Save}" IsDefault="True" Click="SaveClick"/>
  </StackPanel>
  </Grid>
 </Grid>
</Window>
