<Window x:Class="SpotifyPopup.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Spotify Popup" Width="350" Height="200" WindowStyle="None" AllowsTransparency="True" Background="Transparent" Topmost="True" ResizeMode="NoResize" Loaded="OnLoaded" Closed="OnClosed" LocationChanged="OnLocationChanged">
 <Border Background="#EF181818" CornerRadius="14" Padding="16" MouseLeftButtonDown="OnDrag"><Border.ContextMenu><ContextMenu><MenuItem Header="Chiudi" Click="ExitClick"/></ContextMenu></Border.ContextMenu>
  <Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="30"/><RowDefinition Height="44"/></Grid.RowDefinitions>
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="76"/><ColumnDefinition Width="*"/><ColumnDefinition Width="25"/></Grid.ColumnDefinitions>
    <Border Width="70" Height="70" CornerRadius="5" Background="#333333" HorizontalAlignment="Left" VerticalAlignment="Top"><Image x:Name="Cover" Stretch="UniformToFill"/></Border>
    <StackPanel Grid.Column="1" Margin="8,2,0,0"><TextBlock x:Name="TitleText" Text="Apri Spotify" Foreground="White" FontSize="16" FontWeight="Bold" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="ArtistText" Foreground="#B3B3B3" Margin="0,5,0,0" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="AlbumText" Foreground="#909090" FontSize="11" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/></StackPanel>
    <Button Grid.Column="2" Content="🔒" ToolTip="Blocca" Click="LockClick" VerticalAlignment="Top" Background="Transparent" Foreground="White" BorderThickness="0" FontSize="15"/>
   </Grid>
   <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="38"/><ColumnDefinition/><ColumnDefinition Width="38"/></Grid.ColumnDefinitions><TextBlock x:Name="ElapsedText" Foreground="#AAAAAA" FontSize="10" VerticalAlignment="Center"/><Slider x:Name="Progress" Grid.Column="1" VerticalAlignment="Center" Minimum="0" Maximum="100" PreviewMouseLeftButtonUp="Seek"/><TextBlock x:Name="DurationText" Grid.Column="2" Foreground="#AAAAAA" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid>
   <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center"><Button Content="⏮" Click="PreviousClick" Style="{StaticResource PlayerButton}"/><Button x:Name="PlayButton" Content="▶" Click="PlayClick" Style="{StaticResource PlayerButton}" FontSize="22"/><Button Content="⏭" Click="NextClick" Style="{StaticResource PlayerButton}"/></StackPanel>
  </Grid>
 </Border>
</Window>

